{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-translations.mjs\" --hook 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Checking recipe translations"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-translations.mjs\" --hook 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
